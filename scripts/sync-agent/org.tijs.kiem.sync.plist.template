<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.tijs.kiem.sync</string>
	<key>ProgramArguments</key>
	<array>
		<string>__KIEM_BIN__</string>
		<string>--data-dir</string>
		<string>__DATA_DIR__</string>
		<string>sync</string>
	</array>
	<!-- RunAtLoad + KeepAlive(true): `kiem sync` isn't expected to exit on its
	     own, so any exit (crash or clean) means relaunch. -->
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>__LOG_PATH__</string>
	<key>StandardErrorPath</key>
	<string>__LOG_PATH__</string>
</dict>
</plist>
